{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "checkJs": true,
    "baseUrl": "./src",
    "paths": {
      "@core/*": [
        "core/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@server/*": [
        "server/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}